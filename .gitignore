# Rust
/target/
# The examples are their own workspaces, so each has its own build directory.
examples/*/target/
**/*.rs.bk

# Node / web UI (arrives in Phase 4)
node_modules/
dist/
.vite/

# Tauri (arrives in Phase 4)
apps/*/src-tauri/target/
apps/*/src-tauri/gen/

# Local Ephemeral state produced by running the CLI during development
.ephemeral/
/data/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store

# Secrets — nothing of this shape belongs in the repository. See SECURITY.md.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
*.mobileprovision
credentials.json

# Python bytecode from the asset tooling in scripts/
__pycache__/
*.pyc

# The desktop window's test dependencies. Playwright is installed on demand by
# `apps/desktop/tests`, not committed — it is a browser, not a dependency.
apps/desktop/node_modules/
apps/desktop/package-lock.json
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Films of the window, produced by apps/desktop/tests/film.mjs and
# film-window.sh. Regenerate them rather than committing them: a recording in
# the tree ages into a picture of a bug somebody already fixed, and it looks
# exactly as current as the code next to it.
apps/desktop/recordings/

# Android. The engine's .so files are built by apps/android/build-native.sh from
# the Rust in this repository; a compiled library committed next to its own
# source ages into something that looks current and is not.
apps/android/app/src/main/jniLibs/
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
# Written by Android Studio and holds a machine-specific SDK path.
apps/android/local.properties
