#!/usr/bin/env bash
#
# Run everything CI runs, in the same order, so local failures match remote
# ones. Run this before pushing.
#
#   ./scripts/check

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

BOLD=$'\033[1m'; GREEN=$'\033[32m'; RESET=$'\033[0m'
if [ ! -t 1 ]; then BOLD=""; GREEN=""; RESET=""; fi
step() { printf '\n%s==> %s%s\n' "$BOLD" "$1" "$RESET"; }

step "Formatting"
cargo fmt --all -- --check

step "Lints"
cargo clippy --workspace --all-targets --all-features -- -D warnings

step "Tests"
cargo test --workspace --all-features

step "Documentation builds"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features

# The domain layer must not acquire host I/O. Building ephemeral-core without
# default features is what keeps that honest (ADR-0002).
step "Domain purity (ephemeral-core without host I/O)"
cargo build -p ephemeral-core --no-default-features
cargo test -p ephemeral-core --no-default-features

# The sandbox definition and the argument vectors built from it decide the
# confinement, and decide it without spawning anything. Building the runtime
# without its Docker implementation is what keeps that split real (ADR-0014).
step "Sandbox purity (ephemeral-runtime without a daemon)"
cargo build -p ephemeral-runtime --no-default-features
cargo test -p ephemeral-runtime --no-default-features

# CI never makes a live model call (ADR-0008). Generation is exercised entirely
# through the deterministic mock provider.
step "Generating and running, in the crate both clients call"
cargo test -p ephemeral-engine

step "The whole journey, sentence to running application"
cargo test -p ephemeral-agent --test journey
cargo test -p ephemeral-agent --test reference_app -- --nocapture

# Generating is an HTTPS request, and iOS cannot spawn a process. A provider
# whose only transport is `curl` decides that Ephemeral cannot generate on a
# phone — so the crate must compile with no process spawning at all (ADR-0007).
step "Generation is portable (providers without a subprocess transport)"
for provider in anthropic openai local; do
  cargo build -p "ephemeral-provider-$provider" --no-default-features
  cargo test -p "ephemeral-provider-$provider" --no-default-features
done

# Swift and Kotlin both reach Ephemeral through C, so the C ABI is the boundary
# a phone actually uses. Compiling a host against the real header and the real
# static library is the only check that catches a declaration which has drifted
# from its export — the Rust tests link an rlib and can only string-match.
step "The C ABI a phone links against"
crates/ephemeral-ffi/tests/c-abi.sh

# ...and that the same library builds for the architectures phones actually
# are. A static library is assembled rather than linked, so this needs neither
# Xcode nor the Android NDK. First run downloads a standard library per target.
step "Ephemeral builds for the device"
crates/ephemeral-ffi/tests/device-targets.sh

# Android reaches that C ABI through JNI, and JNI is looked up by name at run
# time: a symbol or a signature that has drifted compiles perfectly and fails on
# a phone. A desktop JVM binds it the same way, so the bridge is driven here —
# including the callback into Java that generation depends on.
step "The JNI bridge Android loads"
crates/ephemeral-android/tests/jni.sh

step "Providers reach the network only through curl"
if grep -rniE 'reqwest|hyper|ureq|tokio' crates/ephemeral-provider-*/Cargo.toml; then
  echo "An HTTP stack appeared in a provider crate (ADR-0016)."
  exit 1
fi
# Stronger than it used to be. The transport now lives in ephemeral-agent, so a
# provider crate has no business spawning anything at all.
if grep -rn 'process::Command' crates/ephemeral-provider-*/src --include='*.rs'; then
  echo "A provider spawns a process. Transport belongs in ephemeral-agent."
  exit 1
fi
# And the one module that does spawn is the only one that may.
if grep -rln 'process::Command' crates/ephemeral-agent/src --include='*.rs' \
     | grep -v 'transport.rs'; then
  echo "Something outside the transport module spawns a process."
  exit 1
fi
# The transport is a feature, because iOS forbids one process spawning another.
cargo build -p ephemeral-agent --no-default-features

# `local` is a promise about where a request goes (ADR-0019). Which URLs it
# accepts is tested in the crate; the default is what somebody who configures
# nothing gets, and it has to be on this machine.
step "The local provider's default endpoint is loopback"
if ! grep -qE '^pub const BASE_URL: &str = "http://(127\.0\.0\.1|\[::1\]|localhost)' \
       crates/ephemeral-provider-local/src/lib.rs; then
  echo "The local provider's default endpoint is not on this machine."
  exit 1
fi

step "Generation uses no network client"
if grep -rniE 'reqwest|hyper|ureq|api\.anthropic|api\.openai' \
     crates/ephemeral-agent/src crates/ephemeral-agent/Cargo.toml; then
  echo "A network client appeared in the agent crate. Live model calls must stay out of CI."
  exit 1
fi

# The desktop window renders permission prompts, and a UI that can only be
# exercised by opening a window is a UI nobody tests. These run the real
# modules in headless Chromium.
if command -v node >/dev/null 2>&1 && [ -d apps/desktop/node_modules ]; then
  step "Desktop rendering"
  (cd apps/desktop && node tests/render.test.mjs)

  # The window's Rust half is its own workspace, and needs system libraries the
  # rest of Ephemeral deliberately does not. Built when they are there, skipped
  # with a word when they are not — a command that does not compile is a button
  # that does nothing, and the rendering tests cannot see that.
  if pkg-config --exists gtk+-3.0 2>/dev/null; then
    step "Desktop commands"
    (cd apps/desktop/src-tauri && cargo clippy --all-targets -- -D warnings && cargo test)
  else
    printf '\n(skipping the desktop commands: no GTK development libraries here)\n'
  fi
else
  printf '\n(skipping desktop rendering: run `cd apps/desktop && npm install playwright` first)\n'
fi

# The iOS application, for anybody on a Mac. Says so and passes anywhere else:
# Swift for iOS needs an SDK that only exists on one operating system.
step "The iOS application"
apps/ios/typecheck.sh

# The phone's shell, for anybody who has an Android SDK. Skipped with a word
# when there is none: most people working on the engine do not have one, and CI
# does, which is where this is guaranteed to run.
if [ -n "${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}" ] && command -v gradle >/dev/null 2>&1; then
  step "The Android application"
  (cd apps/android && gradle assembleDebug --console=plain -q)
else
  printf '\n(skipping the Android application: no ANDROID_HOME, or no gradle)\n'
fi

if cargo deny --version >/dev/null 2>&1; then
  step "Supply chain"
  cargo deny check
else
  printf '\n(skipping supply-chain checks: cargo-deny not installed)\n'
fi

printf '\n%sAll checks passed.%s\n\n' "$GREEN" "$RESET"
