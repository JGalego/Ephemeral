#!/usr/bin/env bash
#
# Run everything CI runs, in the same order, so local failures match remote
# ones. Run this before pushing.
#
#   ./scripts/check

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

BOLD=$'\033[1m'; GREEN=$'\033[32m'; RESET=$'\033[0m'
if [ ! -t 1 ]; then BOLD=""; GREEN=""; RESET=""; fi
step() { printf '\n%s==> %s%s\n' "$BOLD" "$1" "$RESET"; }

step "Formatting"
cargo fmt --all -- --check

step "Lints"
cargo clippy --workspace --all-targets --all-features -- -D warnings

step "Tests"
cargo test --workspace --all-features

step "Documentation builds"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features

# The domain layer must not acquire host I/O. Building ephemeral-core without
# default features is what keeps that honest (ADR-0002).
step "Domain purity (ephemeral-core without host I/O)"
cargo build -p ephemeral-core --no-default-features
cargo test -p ephemeral-core --no-default-features

# The sandbox definition and the argument vectors built from it decide the
# confinement, and decide it without spawning anything. Building the runtime
# without its Docker implementation is what keeps that split real (ADR-0014).
step "Sandbox purity (ephemeral-runtime without a daemon)"
cargo build -p ephemeral-runtime --no-default-features
cargo test -p ephemeral-runtime --no-default-features

# CI never makes a live model call (ADR-0008). Generation is exercised entirely
# through the deterministic mock provider.
step "Generation uses no network client"
if grep -rniE 'reqwest|hyper|ureq|api\.anthropic|api\.openai' \
     crates/ephemeral-agent/src crates/ephemeral-agent/Cargo.toml; then
  echo "A network client appeared in the agent crate. Live model calls must stay out of CI."
  exit 1
fi

if cargo deny --version >/dev/null 2>&1; then
  step "Supply chain"
  cargo deny check
else
  printf '\n(skipping supply-chain checks: cargo-deny not installed)\n'
fi

printf '\n%sAll checks passed.%s\n\n' "$GREEN" "$RESET"
