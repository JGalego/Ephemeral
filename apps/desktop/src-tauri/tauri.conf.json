{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ephemeral",
  "version": "0.1.0",
  "identifier": "sh.ephemeral.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ephemeral",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
