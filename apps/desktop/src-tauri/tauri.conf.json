{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ephemeral",
  "version": "0.1.0",
  "identifier": "sh.ephemeral.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ephemeral",
        "width": 900,
        "height": 700,
        "theme": "Dark",
        "backgroundColor": "#0b0e17"
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ephemeral",
    "homepage": "https://github.com/JGalego/Ephemeral",
    "copyright": "Licensed under the Apache License 2.0",
    "licenseFile": "../../../LICENSE",
    "category": "Utility",
    "shortDescription": "Software, on demand.",
    "longDescription": "Ephemeral builds small applications from a sentence, runs them in a sandbox, and throws them away when they stop being useful. Every capability an application is given is asked for in plain language and can be taken back at any time.",
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
