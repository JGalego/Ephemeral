<?xml version="1.0" encoding="utf-8"?>
<!--
  Names for two controls that have no layout file.

  The credential dialog is built in Kotlin, so its field and the menu item that
  opens it had no resource ids — and a control with no id is a control Firebase
  Test Lab cannot be pointed at. Robo finds things by resource name; everything
  else it can only stumble into. These two exist so a run on a real phone can be
  told to put a key in and get past the front door, which is where every device
  run so far has stopped.
-->
<resources>
    <item name="credential_menu" type="id" />
    <item name="credential" type="id" />
    <item name="base_url" type="id" />
    <item name="model" type="id" />
    <item name="check" type="id" />

    <!--
      One per provider, matched by name at run time.

      The list of providers comes from the engine and this does not try to
      mirror it: a provider with no id here still appears in the dialog and can
      still be chosen by hand — it just cannot be named in a `--robo-directives`
      argument, because Robo addresses controls by resource name and a name has
      to exist in the APK before the run.

      A picker built from a Spinner had none of these, which is why every
      device run so far could only exercise whichever provider was the default.
    -->
    <item name="provider_mock" type="id" />
    <item name="provider_anthropic" type="id" />
    <item name="provider_openai" type="id" />
</resources>
