<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by `cargo run -p ephemeral-design`. Do not edit.

  The palette lives in crates/ephemeral-design/src/lib.rs, once, because
  two clients holding their own copies of a risk colour is two clients
  that will eventually disagree about how alarming a permission is.
  Every pairing in it is checked for contrast by that crate's tests.
-->
<resources>
    <!-- the page itself -->
    <color name="ground">#0b0e17</color>
    <!-- the page, one step lighter: gradients and inset areas -->
    <color name="ground_soft">#10141f</color>
    <!-- somebody else's document, drawn on its own paper — white in both schemes, because a generated page does not know which one is in force and will use a browser's own black text -->
    <color name="paper">#ffffff</color>
    <!-- a card sitting on the page -->
    <color name="surface">#151a28</color>
    <!-- something floating over it: a banner, a field, a menu -->
    <color name="surface_high">#1d2334</color>
    <!-- a hairline that separates without drawing attention -->
    <color name="edge">#283149</color>
    <!-- the outline of something you can operate -->
    <color name="edge_strong">#626f90</color>
    <!-- what you are meant to read -->
    <color name="ink">#e9ecf5</color>
    <!-- supporting text: reasons, timestamps, counts -->
    <color name="ink_quiet">#a6afc6</color>
    <!-- the quietest text that is still text -->
    <color name="ink_faint">#8891a8</color>
    <!-- Ephemeral itself: the primary action, and every focus ring -->
    <color name="accent">#a78bfa</color>
    <!-- text on top of the accent -->
    <color name="accent_ink">#0b0e17</color>
    <!-- a ground tinted towards the accent -->
    <color name="accent_soft">#241e45</color>
    <!-- low risk, and things that went well -->
    <color name="low">#4fd69c</color>
    <!-- a ground tinted towards low risk -->
    <color name="low_soft">#102820</color>
    <!-- medium risk, and anything that needs care but is not wrong -->
    <color name="medium">#f0b44e</color>
    <!-- a ground tinted towards medium risk -->
    <color name="medium_soft">#2a2110</color>
    <!-- high risk, and failures -->
    <color name="high">#ff9057</color>
    <!-- a ground tinted towards high risk -->
    <color name="high_soft">#2e1a12</color>
    <!-- the permissions that can do the most damage -->
    <color name="critical">#ff7a8a</color>
    <!-- a ground tinted towards critical risk -->
    <color name="critical_soft">#301419</color>
</resources>
