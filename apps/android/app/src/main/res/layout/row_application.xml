<?xml version="1.0" encoding="utf-8"?>
<!--
  One application in the list, as a card.

  The purpose comes first because that is what a person recognises — an
  application's generated name is Ephemeral's convenience, not theirs. What it
  is waiting for, where it is, and what it already holds are three separate
  facts and are drawn as three, because a single grey subtitle joining them
  with dots was how a running application that could reach the whole internet
  came to look exactly like an idle one that can see nothing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/purpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="@color/ink_quiet"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="@color/ink_quiet"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/awaiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="@color/ground"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/granted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
