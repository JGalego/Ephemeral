<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/applications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/surface"
            android:dividerHeight="1dp"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/nothing_yet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:padding="32dp"
            android:text="@string/nothing_yet"
            android:textColor="@color/quiet"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="12dp"
        android:textColor="@color/care"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/intent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/intent_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:textColor="@color/text"
            android:textColorHint="@color/quiet" />

        <Button
            android:id="@+id/create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp"
        android:text="@string/phone_limits"
        android:textColor="@color/quiet"
        android:textSize="12sp" />

</LinearLayout>
