<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/applications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/nothing_yet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:lineSpacingMultiplier="1.3"
            android:padding="32dp"
            android:text="@string/nothing_yet"
            android:textColor="@color/ink_quiet"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Anything that went wrong sits directly above the control that caused
         it, so it cannot be rendered somewhere nobody is looking. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/high_soft"
        android:padding="14dp"
        android:textColor="@color/high"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- The front door. It sits at the bottom because that is where a thumb
         is, and it is the one filled control on this screen: asking for an
         application grants nothing. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/intent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/field"
                android:hint="@string/intent_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textSize="15sp" />

            <Button
                android:id="@+id/create"
                style="@style/EphemeralButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/create" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/phone_limits"
            android:textColor="@color/ink_quiet"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
